# Shared
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
RESULT_TTL_S=86400
QUEUE_NAME=arq:queue

# API
MAX_FILE_SIZE_BYTES=102400
MAX_DOC_CHARS=4096
MAX_QUERY_LENGTH=1000
RATE_LIMIT=20/second
RATE_LIMIT_STRATEGY=fixed-window
MAX_QUEUE_DEPTH=1000
RETRY_AFTER_BASE_S=5
POLL_INTERVAL_HINT_S=1
API_CONCURRENCY_LIMIT=200

# Worker
BATCH_MAX_SIZE=32
BATCH_LINGER_MS=10
POLL_DELAY_S=0.1
VISIBILITY_TIMEOUT_S=30
SHUTDOWN_GRACE_S=5
MAX_ATTEMPTS=3
TORCH_NUM_THREADS=2
OMP_NUM_THREADS=2
METRICS_PORT=9100

# Build-time only (Dockerfile ARG, not read at runtime by pydantic-settings)
# MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
